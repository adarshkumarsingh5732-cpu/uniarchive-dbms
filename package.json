{
  "name": "uniarchives",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"api,app,tunnel\" -c \"cyan,magenta,green\" \"npm --prefix server run dev\" \"vite\" \"npm run tunnel\"",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix server run dev",
    "tunnel": "lt --port 5001 --subdomain uniarchive-scse-demo",
    "demo": "concurrently -n \"api,tunnel\" -c \"cyan,green\" \"npm --prefix server run dev\" \"npm run tunnel\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cloudinary": "^2.9.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "lucide-react": "^0.563.0",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.24.5",
    "nodemailer": "^8.0.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.19.11",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "localtunnel": "^2.0.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
