# ---------------------------------------------------------------------------
# UniArchive server configuration — copy to `.env` and adjust.
#   cp server/.env.example server/.env
# ---------------------------------------------------------------------------

# --- Database (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=test_uniarchive

# --- HTTP ---
PORT=5000
# Set to "production" to silence per-request logging.
NODE_ENV=development
# Comma-separated origin allowlist for CORS. Leave blank for open access.
CORS_ORIGIN=
# Optional: require a specific email domain for OTP login (e.g. vitstudent.ac.in)
ALLOWED_EMAIL_DOMAIN=

# --- Cloudinary (file uploads for POST /api/resources) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP (OTP delivery for POST /api/auth/otp) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- AI assistant (POST /api/ai/ask) ---
NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama3-70b-instruct
# AI assistant (OpenAI-compatible). Velona gateway + a cheap DeepSeek model.
AI_BASE_URL=https://velona.in/v1
AI_MODEL=deepseek/deepseek-v4-flash-0731
AI_API_KEY=your-velona-key
